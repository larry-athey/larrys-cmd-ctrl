#!/bin/bash

chown -R www-data:www-data /var/www/html
chmod g+w -R /var/www/html

chown -R www-data:www-data /usr/share/lcc
chmod g+w -R /usr/share/lcc

cd /usr/share/lcc

Hour=$(date +%H)
Min=$(date +%M)

if [ "$Hour" == "00" ] && [ "$Min" == "15" ]; then
  pkill -f /usr/share/lcc/lcc-bash-loop
  ./lcc-db-maint.php
  sleep 15
fi

if [ "$Min" == "00" ]; then
  ./pinger.php &
fi

LoopFailure=0

ps cax | grep [t]imeline-run.php
if [ $? -ne 0 ]; then
  LoopFailure=1
fi

ps cax | grep [t]imeline-queue.php
if [ $? -ne 0 ]; then
  LoopFailure=1
fi

ps cax | grep [l]cc-bash-loop
if [ $? -ne 0 ]; then
  LoopFailure=1
fi

if [ $LoopFailure -eq 1 ]; then
  pkill -f /usr/share/lcc/timeline-run.php
  pkill -f /usr/share/lcc/timeline-queue.php
  pkill -f /usr/share/lcc/lcc-bash-loop
  /usr/share/lcc/timeline-run.php &
  /usr/share/lcc/timeline-queue.php &
  /usr/share/lcc/lcc-bash-loop &
fi
