#!/bin/bash

cd /usr/share/lcc

./timeline-run.php &
./timeline-queue.php &

LoopCounter=0

while [ true ]; do
  ScriptStart=$(date +%s)

  ./logic-processor.php

  LoopCounter=$((LoopCounter + 1))

  if [ $LoopCounter -eq 12 ]; then
    ./ap-check.php &
    ./scheduler.php
    LoopCounter=0
  fi

  ScriptEnd=$(date +%s)

  Runtime=$(($ScriptEnd - $ScriptStart))
  echo "Script Runtime: $Runtime seconds"
  if [ $Runtime -lt 5 ]; then
    Delay=$((5 - $Runtime))
    echo "Sleeping $Delay seconds"
    sleep $Delay
  fi
done
